{
  "name": "api-server-2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "remote": "bun wrangler dev --remote",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "auth:generate": "bunx @better-auth/cli generate --config ./src/lib/auth.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "postgres": "^3.4.9",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.83.0"
  }
}
